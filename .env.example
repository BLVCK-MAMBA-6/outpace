# Supabase
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# Legacy fallback only. Prefer SUPABASE_PUBLISHABLE_KEY.
SUPABASE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_AUTH_REDIRECT_URL=http://localhost:5173/auth/callback

# Gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3-flash
GEMINI_FALLBACK_MODEL=gemini-2.5-flash

# Redis / Celery (local development defaults)
REDIS_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1
MONITORING_EXCLUDED_COMPETITOR_IDS=

# Resend
RESEND_API_KEY=
RESEND_FROM_EMAIL=
# Used only by: python -m workers.email.digest --test
DIGEST_TEST_EMAIL=

# App
ENVIRONMENT=development
FRONTEND_URL=http://localhost:5173

# G2 Reviews API
G2_API_TOKEN=
G2_API_BASE_URL=https://data.g2.com

# Production error monitoring
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
VITE_SENTRY_DSN=
VITE_SENTRY_ENVIRONMENT=development
VITE_SENTRY_RELEASE=
